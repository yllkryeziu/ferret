        "@googletest//:gtest_main",
        "@re2",
    ],
)

cc_test(
    name = "fold_exceptions_test",
    size = "small",
    srcs = ["fold_exceptions_test.cc"],
    copts = FERRET_TEST_COPTS,
    deps = [
        "//ferret/text:fold",
