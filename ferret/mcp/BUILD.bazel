load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel:copts.bzl", "FERRET_DEFAULT_COPTS", "FERRET_TEST_COPTS")

package(default_visibility = ["//visibility:private"])

cc_library(
    name = "protocol",
    hdrs = ["protocol.h"],
    copts = FERRET_DEFAULT_COPTS,
    visibility = ["//ferret:internal"],
    deps = ["@abseil-cpp//absl/strings"],
)

cc_library(
    name = "mcp_tool",
    srcs = ["mcp_tool.cc"],
    hdrs = ["mcp_tool.h"],
    copts = FERRET_DEFAULT_COPTS,
    visibility = ["//ferret:internal"],
    deps = [
        "//ferret/rpc:json_codec",
        "@abseil-cpp//absl/algorithm:container",
        "@abseil-cpp//absl/base:core_headers",
        "@abseil-cpp//absl/base:nullability",
        "@abseil-cpp//absl/container:flat_hash_set",
        "@abseil-cpp//absl/log:check",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:status_macros",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/synchronization",
        "@abseil-cpp//absl/types:span",
        "@nlohmann_json//:json",
    ],
)

cc_test(
    name = "mcp_tool_test",
    size = "small",
    srcs = ["mcp_tool_test.cc"],
    copts = FERRET_TEST_COPTS,
    deps = [
        ":mcp_tool",
        "//ferret/mcp/testing:fake_mcp_tools",
        "//ferret/rpc:json_codec",
        "//ferret/rpc/testing:test_pipe",
        "//ferret/text:lexer",
        "//ferret/testing:test_seed",
        "//ferret/testing:status_matchers",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:status_matchers",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/synchronization",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@nlohmann_json//:json",
    ],
)

cc_library(
    name = "mcp_server",
    srcs = ["mcp_server.cc"],
    hdrs = ["mcp_server.h"],
    copts = FERRET_DEFAULT_COPTS,
    visibility = ["//ferret:internal"],
    deps = [
        ":mcp_tool",
        ":protocol",
        "//ferret/rpc:framing",
        "//ferret/rpc:json_codec",
        "//ferret/rpc:json_rpc",
        "//ferret/text:utf8",
        "@abseil-cpp//absl/algorithm:container",
        "@abseil-cpp//absl/base:core_headers",
        "@abseil-cpp//absl/container:flat_hash_map",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/log:check",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/synchronization",
        "@abseil-cpp//absl/time",
        "@nlohmann_json//:json",
    ],
)

cc_test(
    name = "mcp_server_test",
    size = "medium",
    srcs = ["mcp_server_test.cc"],
    copts = FERRET_TEST_COPTS,
