        "@abseil-cpp//absl/status:status_matchers",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/time",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "fsevents_watcher_test_lib",
    testonly = True,
    srcs = ["fsevents_watcher_test.cc"],
    copts = FERRET_TEST_COPTS,
    target_compatible_with = ["@platforms//os:macos"],
    # Compiled in the sandbox so layering_check sees only declared headers.
    alwayslink = True,
    deps = [
        ":fsevents_watcher",
        ":watcher_interface",
        "//ferret/testing:status_matchers",
        "//ferret/testing:temp_dir",
        "@abseil-cpp//absl/base:core_headers",
        "@abseil-cpp//absl/cleanup",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:status_matchers",
        "@abseil-cpp//absl/synchronization",
        "@abseil-cpp//absl/time",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "fsevents_watcher_test",
    size = "medium",
    # FSEvents is not reliably delivered across the Bazel macOS sandbox
    # boundary. Only linking and running happen outside the sandbox.
    tags = ["no-sandbox"],
    target_compatible_with = ["@platforms//os:macos"],
    deps = [":fsevents_watcher_test_lib"],
