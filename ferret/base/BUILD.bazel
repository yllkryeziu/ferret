load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel:copts.bzl", "FERRET_DEFAULT_COPTS", "FERRET_STRICT_SIGN_COPTS", "FERRET_TEST_COPTS")

package(default_visibility = ["//visibility:private"])

cc_library(
    name = "ablation",
    hdrs = ["ablation.h"],
    copts = FERRET_DEFAULT_COPTS,
    visibility = ["//ferret:internal"],
)

cc_library(
    name = "stage_clock",
    hdrs = ["stage_clock.h"],
    copts = FERRET_DEFAULT_COPTS,
    visibility = ["//ferret:internal"],
)

cc_library(
    name = "bitset",
    srcs = ["bitset.cc"],
    hdrs = ["bitset.h"],
    copts = FERRET_DEFAULT_COPTS + FERRET_STRICT_SIGN_COPTS,
    visibility = ["//ferret:internal"],
    deps = [
        "@abseil-cpp//absl/functional:function_ref",
        "@abseil-cpp//absl/log:check",
    ],
)

cc_test(
    name = "bitset_test",
    size = "small",
    srcs = ["bitset_test.cc"],
    copts = FERRET_TEST_COPTS,
    deps = [
        ":bitset",
        "//ferret/testing:test_seed",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "env",
