# Wraps each query in a C++ raw string literal, so the extractor never reads
# files at run time.
genrule(
    name = "embedded_queries_h",
    srcs = [
        "queries/c.scm",
        "queries/cpp.scm",
        "queries/python.scm",
    ],
    outs = ["internal/embedded_queries.h"],
    cmd = """
set -eu
embed() {
  if grep -qF ')scm"' "$$2"; then
    echo "$$2 contains the raw string delimiter" >&2
    exit 1
  fi
  printf '\\ninline constexpr absl::string_view %s = R"scm(' "$$1"
  cat "$$2"
  printf ')scm";\\n'
}
{
  printf '%s\\n' \\
    '// Copyright 2026 The Ferret Authors.' \\
    '// SPDX-License-Identifier: Apache-2.0' \\
    '//' \\
    '// Generated from ferret/symbols/queries/*.scm by' \\
    '// //ferret/symbols:embedded_queries_h. Do not edit.' \\
    '' \\
    '#ifndef FERRET_SYMBOLS_INTERNAL_EMBEDDED_QUERIES_H_' \\
    '#define FERRET_SYMBOLS_INTERNAL_EMBEDDED_QUERIES_H_' \\
    '' \\
    '#include "absl/strings/string_view.h"' \\
    '' \\
    'namespace ferret::symbols_internal {'
  embed kCQuery $(location queries/c.scm)
  embed kCppQuery $(location queries/cpp.scm)
  embed kPythonQuery $(location queries/python.scm)
  printf '%s\\n' \\
    '' \\
    '}  // namespace ferret::symbols_internal' \\
    '' \\
    '#endif  // FERRET_SYMBOLS_INTERNAL_EMBEDDED_QUERIES_H_'
} > $@
""",
)

cc_library(
