        "@abseil-cpp//absl/functional:function_ref",
        "@abseil-cpp//absl/strings",
        "@re2",
    ],
)

cc_test(
    name = "verifier_test",
    # The randomized reference test takes about 45 s under TSan.
    size = "medium",
    srcs = ["verifier_test.cc"],
    copts = FERRET_TEST_COPTS,
    deps = [
        ":verifier",
        "//ferret/regex:compile",
        "//ferret/regex:regex_gen",
        "//ferret/testing:test_seed",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@re2",
    ],
)

cc_library(
