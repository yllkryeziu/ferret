load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel:copts.bzl", "FERRET_DEFAULT_COPTS", "FERRET_STRICT_SIGN_COPTS", "FERRET_TEST_COPTS")

package(default_visibility = ["//visibility:private"])

cc_library(
    name = "json_codec",
    srcs = ["json_codec.cc"],
    hdrs = ["json_codec.h"],
    copts = FERRET_DEFAULT_COPTS + FERRET_STRICT_SIGN_COPTS,
    # `defines` (not `local_defines`) so that every translation unit that sees
    # nlohmann::json through this library agrees on its definition.
    defines = ["JSON_USE_IMPLICIT_CONVERSIONS=0"],
    visibility = ["//ferret:internal"],
    deps = [
        "@abseil-cpp//absl/base:core_headers",
        "@abseil-cpp//absl/log:check",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:status_macros",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@nlohmann_json//:json",
    ],
)

